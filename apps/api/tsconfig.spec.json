{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/spec",
    "tsBuildInfoFile": "out-tsc/spec/tsconfig.spec.tsbuildinfo",
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true
  },
  // Checks app sources directly rather than through tsconfig.app.json's
  // outputs, which the build's own type-check leaves without declarations.
  "include": ["src/**/*.ts", "prisma/seed.ts", "vitest.config.ts"],
  "references": [{ "path": "../../libs/media/tsconfig.lib.json" }]
}
