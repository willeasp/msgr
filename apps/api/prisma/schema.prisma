generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  password  String
  chats     Chat[]    @relation("ChatParticipants")
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Exactly one of `directKey` and `title` is set (enforced by a CHECK constraint).
model Chat {
  id           String    @id @default(cuid())
  /// Direct chats only: the two participant ids, sorted and joined by ":".
  /// Unique, so two users share at most one direct chat.
  directKey    String?   @unique
  /// Group chats only. A direct chat is titled by its counterpart's name.
  title        String?
  participants User[]    @relation("ChatParticipants")
  messages     Message[]
  createdAt    DateTime  @default(now())
  /// Bumped on every new message; orders a user's chat list.
  updatedAt    DateTime  @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  content   String
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId, createdAt, id])
  @@index([senderId])
}
