generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String
  password          String
  /// A 64×64 picture, raw-DEFLATEd like a message's; null for the default.
  avatar            Bytes?
  chats             Chat[]             @relation("ChatParticipants")
  messages          Message[]
  invitesSent       Invite[]           @relation("InvitesSent")
  invite            Invite?            @relation("InviteUsed")
  pushSubscriptions PushSubscription[]
  uploads           Upload[]
  readMarks         ReadMark[]
  readPoints        ReadPoint[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

/// Exactly one of `directKey`, `title` and `channelName` is set, which says
/// what kind of chat it is (enforced by a CHECK constraint).
model Chat {
  id           String      @id @default(cuid())
  /// Direct chats only: the two participant ids, sorted and joined by ":".
  /// Unique, so two users share at most one direct chat.
  directKey    String?     @unique
  /// Group chats only. A direct chat is titled by its counterpart's name.
  title        String?
  /// Channels only: the name without its "#". Unique, so a name means one channel.
  channelName  String?     @unique
  participants User[]      @relation("ChatParticipants")
  messages     Message[]
  readPoints   ReadPoint[]
  createdAt    DateTime    @default(now())
  /// Bumped on every new message; orders a user's chat list.
  updatedAt    DateTime    @updatedAt
}

/// Text, a picture, a movie or a sound, or text with one of them: at least
/// one is set, never two attached, and each attached one has its size
/// (enforced by a CHECK constraint).
model Message {
  id            String      @id @default(cuid())
  content       String?
  /// A 1-bit picture, raw DEFLATE of the `@msgr/media` layout; see domain/picture.ts.
  picture       Bytes?
  pictureWidth  Int?        @db.SmallInt
  pictureHeight Int?        @db.SmallInt
  /// A 1-bit movie, its frames coded by `encodeMovie`; see domain/movie.ts.
  movie         Bytes?
  movieWidth    Int?        @db.SmallInt
  movieHeight   Int?        @db.SmallInt
  movieFrames   Int?        @db.SmallInt
  /// A squashed sound, its codes from `encodeSound`; see domain/sound.ts.
  sound         Bytes?
  soundFrames   Int?        @db.SmallInt
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  chatId        String
  chat          Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  readMarks     ReadMark[]
  readPoints    ReadPoint[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([chatId, createdAt, id])
  /// Someone's newest message in a chat, which reads all before it, at once.
  @@index([senderId, chatId, createdAt, id])
}

/// A message's picture, movie or sound, put by its sender ahead of the
/// message (ADR 0018), under the id the message will have: exactly one is
/// set, with its size, as on a message (enforced by a CHECK constraint). The
/// message takes it as it's stored; one whose message never comes is
/// forgotten an hour after it was put.
model Upload {
  /// The id its message will have, chosen by its sender.
  id            String   @id
  uploaderId    String
  uploader      User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  picture       Bytes?
  pictureWidth  Int?     @db.SmallInt
  pictureHeight Int?     @db.SmallInt
  movie         Bytes?
  movieWidth    Int?     @db.SmallInt
  movieHeight   Int?     @db.SmallInt
  movieFrames   Int?     @db.SmallInt
  sound         Bytes?
  soundFrames   Int?     @db.SmallInt
  createdAt     DateTime

  @@index([createdAt])
}

/// How far someone had read a chat, and when: they read it up to and
/// including this message. Each message they've read was first read at the
/// earliest of their marks on it or a later message in its chat.
model ReadMark {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  readAt    DateTime

  @@id([userId, messageId])
  @@index([messageId])
}

/// How far someone has read a chat now: up to and including this message,
/// their latest ReadMark there. One per person and chat, only ever moved
/// forward, so what's unread is counted from it without walking the marks.
model ReadPoint {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId    String
  chat      Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, chatId])
  @@index([messageId])
}

/// A single-use way in for someone new. Stores a hash of the code, never the
/// code itself, so the database alone cannot sign anyone up.
model Invite {
  /// SHA-256 of the code, hex.
  codeHash    String    @id
  invitedById String?
  invitedBy   User?     @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?   @unique
  usedBy      User?     @relation("InviteUsed", fields: [usedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

/// One browser's Web Push subscription, and the user it notifies.
model PushSubscription {
  /// Its address at the browser vendor's push service. The key, so a browser
  /// notifies one user at a time.
  endpoint  String   @id
  p256dh    String
  auth      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}
