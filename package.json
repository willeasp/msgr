{
  "name": "@msgr/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "db:start": "npx prisma dev",
    "db:migrate": "npm --workspace=@msgr/api exec prisma migrate dev",
    "db:seed": "npm --workspace=@msgr/api exec prisma db seed",
    "db:generate": "npm --workspace=@msgr/api exec prisma generate",
    "db:setup": "npm run db:migrate && npm run db:generate && npm run db:seed",
    "dev": "npx nx run-many -t serve",
    "dev:api": "npx nx serve api",
    "dev:frontend": "npx nx serve frontend",
    "build": "npx nx run-many -t build",
    "typecheck": "npx nx run-many -t typecheck",
    "codegen": "npx nx run-many -t codegen"
  },
  "private": true,
  "dependencies": {
    "@apollo/client": "^4.0.9",
    "@apollo/server": "^5.1.0",
    "axios": "^1.6.0",
    "graphql": "^16.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.29.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@graphql-codegen/cli": "^6.0.2",
    "@graphql-codegen/typescript": "^5.0.4",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@graphql-codegen/typescript-resolvers": "^5.1.2",
    "@nx/esbuild": "22.0.3",
    "@nx/eslint": "22.0.3",
    "@nx/eslint-plugin": "22.0.3",
    "@nx/js": "22.0.3",
    "@nx/node": "22.0.3",
    "@nx/react": "^22.0.3",
    "@nx/vite": "22.0.3",
    "@nx/web": "22.0.3",
    "@nx/workspace": "22.0.3",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^3.0.0",
    "autoprefixer": "10.4.13",
    "esbuild": "^0.19.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "nx": "22.0.3",
    "postcss": "8.4.38",
    "prettier": "^2.6.2",
    "tailwindcss": "3.4.3",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "workspaces": [
    "apps/*"
  ]
}
